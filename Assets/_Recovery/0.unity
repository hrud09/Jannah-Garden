  defaultText: Welcome to Jannah Garden!
  translations:
  - language: 1
    text: "\u0645\u0631\u062D\u0628\u0627 \u0628\u0643\u0645 \u0641\u064A \u062D\u062F\u064A\u0642\u0629
      \u0627\u0644\u062C\u0646\u0629!"
  - language: 2
